SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENROUTER_API_KEY=your-openrouter-key
# Optional: defaults to OpenRouter's free model router.
STRANDS_MODEL_ID=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Kloppy
# Optional Walrus Memory support. Generate an account and delegate key at
# https://memory.walrus.xyz. Keep the private key server-side; never add it
# to frontend/.env or commit it.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Additional comma-separated browser origins allowed by the API.
FRONTEND_ORIGINS=https://kloppy.vercel.app
ENVIRONMENT=development
QLOO_API_KEY=your-qloo-api-key
QLOO_API_URL=https://api.qloo.com
# Optional web research for Kloppy. Keep this key server-side.
TAVILY_API_KEY=
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for user-managed MCP connections; keep stable across backend deploys.
INTEGRATION_ENCRYPTION_KEY=
# Optional Streamable HTTP MCP server config. Keep credentials in env vars.
# Each server must have an explicit allowed_tools list; only MCP tools marked read-only are exposed.
# Example: {"mcpServers":{"google_drive":{"url":"https://your-drive-mcp.example/mcp","headers":{"Authorization":"Bearer ${env:GOOGLE_DRIVE_MCP_TOKEN}"},"allowed_tools":["search_files","get_file"]}}}
MCP_SERVERS_JSON=
